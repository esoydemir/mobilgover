# /etc/goverhub/watchdog.env — BACKUP / WATCHDOG server. Needs no database and no key.
BACKUP_TARGET_DIR=/srv/goverhub-yedek
BACKUP_WATCH_STATE_FILE=/srv/goverhub/var/backup-watch.json
BACKUP_AGE_WARN_MINUTES=40
BACKUP_AGE_CRITICAL_MINUTES=50
BACKUP_RPO_MINUTES=60
ALERT_WEBHOOK_URL=<bildirim adresi>
