# /etc/goverhub/pilot.env — APPLICATION server. chmod 600, owner goverhub. Never commit the filled file.
DATABASE_URL=postgres://goverhub_app:<parola>@127.0.0.1:5432/goverhub
DATABASE_OWNER_URL=postgres://goverhub_owner:<parola>@127.0.0.1:5432/goverhub
EVIDENCE_DIR=/srv/goverhub/evidence
PORT=3000
# Only Caddy on this server reaches the API.
HOST=127.0.0.1
DEMO_MODE=false
PUBLIC_BASE_URL=https://pilot.ornek.com.tr
# The API is reached through Caddy on the same address (/api); no cross-origin calls.
CORS_ORIGINS=
TRUST_PROXY=127.0.0.1
MFA_ENCRYPTION_KEY=<openssl rand -base64 32>
MFA_REQUIRED_FOR_PLATFORM=true
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=<sağlayıcıdan>
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USER=<sağlayıcıdan>
MAIL_SMTP_PASS=<sağlayıcıdan>
MAIL_FROM=giris@<alan-adı>
# true ONLY after the first real delivery was confirmed together.
MAIL_PRODUCTION_READY=false
BACKUP_TARGET_DIR=/mnt/goverhub-yedek
# Present on this server only as long as needed; the original stays in the vault.
BACKUP_ENCRYPTION_KEY_FILE=/etc/goverhub/backup.key
BACKUP_STATUS_FILE=/srv/goverhub/var/backup-status.json
BACKUP_KEEP_HOURS=48
BACKUP_KEEP_DAYS=30
BACKUP_DEEP_SAMPLE=20
ALERT_WEBHOOK_URL=<bildirim adresi>
