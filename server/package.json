{
  "name": "goverhub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed:demo": "tsx src/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx src/ops/cli.ts backup",
    "backup:verify": "tsx src/ops/cli.ts verify",
    "restore": "tsx src/ops/cli.ts restore",
    "check:integrity": "tsx src/ops/cli.ts integrity",
    "backup:list": "tsx src/ops/cli.ts list",
    "backup:scheduled": "tsx src/ops/cli.ts scheduled",
    "backup:watchdog": "tsx src/ops/cli.ts watchdog",
    "ops:loadgen": "tsx src/ops/loadgen.ts",
    "backup:key-check": "tsx src/ops/cli.ts key-check",
    "admin:list": "tsx src/ops/admin.ts list",
    "admin:grant": "tsx src/ops/admin.ts grant",
    "admin:revoke": "tsx src/ops/admin.ts revoke",
    "pilot:check": "tsx src/ops/pilotcheck.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
