# Runtime connection: a role that does NOT own the tables, so row-level security applies.
DATABASE_URL=postgres://goverhub_app:CHANGE_ME@localhost:5432/goverhub
# Migration connection: the table owner. Used only by `npm run migrate` and tests.
DATABASE_OWNER_URL=postgres://goverhub_owner:CHANGE_ME@localhost:5432/goverhub
# Local evidence storage directory (replace with object storage in production).
EVIDENCE_DIR=./var/evidence
PORT=3000
# Listen address. Pilot: 127.0.0.1 only (the HTTPS proxy on the same server is the only way in); refused otherwise.
# 0.0.0.0 is accepted only with DEMO_MODE=true (local/LAN development).
HOST=127.0.0.1
# Address(es) of the reverse proxy whose X-Forwarded-For is trusted. Explicit IPs/CIDRs only; true or * are refused.
TRUST_PROXY=
# Local development and the separate demo/test environment: true (demo sign-in, example rules, demo reset).
# Pilot: false — then MAIL_TRANSPORT=smtp is required and the app refuses dev_outbox.
# true is refused on a database that holds a real (non-demo) company.
DEMO_MODE=true
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts second-factor secrets.
MFA_ENCRYPTION_KEY=
# Rule reviewers and platform admins must use a second factor (set false only for local development).
MFA_REQUIRED_FOR_PLATFORM=true
# dev_outbox: sign-in codes stay in the database (DEMO_MODE=true only; required there).
# smtp: DEMO_MODE=false only (required there).
# smtp: any provider's SMTP service. TLS is required (tls = implicit, port 465; starttls = port 587).
MAIL_TRANSPORT=dev_outbox
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=
# Set to true by a person ONLY after a real delivery through the chosen provider was confirmed.
MAIL_PRODUCTION_READY=false
# Comma-separated web origins allowed to call the API (web build of the app), e.g. https://app.example.com
CORS_ORIGINS=

# ── Backups (backup:scheduled every 30 min; backup:watchdog every 5 min on ANOTHER machine) ──
# A location OUTSIDE this server (mounted remote volume / separate disk). Only encrypted objects go there.
BACKUP_TARGET_DIR=
# The key: preferably a file outside both the evidence directory and the backup target (refused otherwise),
# present on the server only as long as needed. Keep the original in a password vault + offline copy.
# Generate once: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY_FILE=
# Alternative to the file (not both):
BACKUP_ENCRYPTION_KEY=
BACKUP_STATUS_FILE=./var/backup-status.json
# Retention: every backup of the last 48 hours, one per day for 30 days.
BACKUP_KEEP_HOURS=48
BACKUP_KEEP_DAYS=30
BACKUP_DEEP_SAMPLE=20
# Watchdog (age of the last usable backup in the target, measured from its snapshot).
BACKUP_WATCH_STATE_FILE=./var/backup-watch.json
BACKUP_AGE_WARN_MINUTES=40
BACKUP_AGE_CRITICAL_MINUTES=50
BACKUP_RPO_MINUTES=60
# Alerts are POSTed here as JSON.
ALERT_WEBHOOK_URL=
