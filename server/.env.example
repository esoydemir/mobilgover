# Runtime connection: a role that does NOT own the tables, so row-level security applies.
DATABASE_URL=postgres://goverhub_app:CHANGE_ME@localhost:5432/goverhub
# Migration connection: the table owner. Used only by `npm run migrate` and tests.
DATABASE_OWNER_URL=postgres://goverhub_owner:CHANGE_ME@localhost:5432/goverhub
# Local evidence storage directory (replace with object storage in production).
EVIDENCE_DIR=./var/evidence
PORT=3000
# Set to "true" only on demo deployments. Enables POST /admin/demo/reset.
DEMO_MODE=false
